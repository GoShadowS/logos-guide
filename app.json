{
  "expo": {
    "name": "ЛОГОС: Путеводитель",
    "description": "Офлайн-навигация по учебному корпусу колледжа АНО ПО «ТК \"Логос\"»: планы этажей, поиск и маршруты",
    "slug": "logos-guide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "logosguide",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#1512E8",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "ru.logos.guide",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": false
    },
    "android": {
      "package": "ru.logos.guide",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0B0B14"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геопозиция нужна, чтобы показать вас на плане этажа и ориентировать внутри корпуса."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Микрофон используется для голосового поиска аудиторий и мест.",
          "speechRecognitionPermission": "Распознавание речи используется для голосового поиска."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0f8186f2-4f2a-4a97-a640-d5f5dc283834"
      }
    },
    "owner": "shad11t",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0f8186f2-4f2a-4a97-a640-d5f5dc283834"
    }
  }
}
