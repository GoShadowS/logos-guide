    <string name="about_purpose_value">Indoor wayfinding at the college</string>
    <string name="about_project_warning">Routes are based on the supplied plans. Before use, verify room coordinates, passable paths, doors and floor connections in the building.</string>
    <string name="splash_description">LOGOS: Guide splash screen</string>

    <!-- Ten-step interactive tutorial. -->
    <string name="onboarding_welcome_title">Welcome to LOGOS: Guide!</string>
    <string name="onboarding_welcome_body">A convenient guide to Logos College.</string>
    <string name="onboarding_welcome_tip">Floor maps, room search and offline routes.</string>
    <string name="onboarding_language_title">Choose a language</string>
    <string name="onboarding_location_title">Location permission</string>
    <string name="onboarding_location_body">To automatically estimate your position inside the college, the app needs location access. It lets the map show where you are and builds routes automatically.</string>
    <string name="onboarding_location_manual_note">If you decline, GPS mode will be unavailable, but you can mark your position on the map manually.</string>
    <string name="onboarding_allow_location">Allow location access</string>
    <string name="onboarding_map_title">Map controls</string>
    <string name="onboarding_map_body">Pan the plan, zoom in on an area and open room cards.</string>
    <string name="onboarding_map_pan">👆 One finger — drag to pan the map.</string>
    <string name="onboarding_map_zoom">🤏 Two fingers — pinch to zoom in or out.</string>
    <string name="onboarding_map_tap">👆 Tap a room for details. To start inside it, choose “My place” and tap the room.</string>
    <string name="onboarding_map_floors">🔄 Floor buttons switch between building plans.</string>
    <string name="onboarding_modes_title">Two location modes</string>
    <string name="onboarding_modes_gps">📡 GPS estimates your position automatically; it usually works better near windows than deep inside the building.</string>
    <string name="onboarding_modes_manual">👆 In manual mode, tap the target and choose a point on the plan — you can mark yourself inside a room.</string>
    <string name="onboarding_modes_switch">The mode switch is on the map screen.</string>
    <string name="onboarding_route_title">How to build a route</string>
    <string name="onboarding_route_step_1">1. Allow GPS or mark your position manually.</string>
    <string name="onboarding_route_step_2">2. Choose a destination on the map, in Search or in Favorites.</string>
    <string name="onboarding_route_step_3">3. Review the route preview and the full list of steps.</string>
    <string name="onboarding_route_step_4">4. Tap “Start route” and follow the highlighted steps; manual mode has Previous and Next controls.</string>
    <string name="onboarding_elevator_title">Using the elevator</string>
    <string name="onboarding_elevator_warning">The elevator is reserved for people who need an accessible route. Other users should take the stairs.</string>
    <string name="onboarding_elevator_question">Do you need to use the elevator?</string>
    <string name="onboarding_elevator_no">No, I will use the stairs</string>
    <string name="onboarding_elevator_yes">Yes, I need the elevator for medical reasons</string>
    <string name="onboarding_favorites_title">Favorite places</string>
    <string name="onboarding_favorites_body">Add frequently visited rooms to Favorites to build routes to them quickly. Create folders such as “My classes” or “Exams”. Your data stays on this device.</string>
    <string name="onboarding_settings_title">Settings and help</string>
    <string name="onboarding_settings_body">Change the theme, language, route color, text size and more. You can restart this tutorial from Settings at any time.</string>
    <string name="onboarding_done_title">All set!</string>
    <string name="onboarding_done_body">You know the basics. Enjoy finding your way around Logos College!</string>
    <string name="onboarding_done_tip">Start with the map or search for a room.</string>
